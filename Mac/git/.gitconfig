[user]
	email = kmerecido@gmail.com
	name = Karl Merecido

[init]
	defaultBranch = main

# Per-client/per-employer git identities (which email applies under which
# projects directory) live in an untracked, machine-local ~/.gitconfig-local,
# not here - see .gitconfig-local.template. That keeps client/employer names
# out of this shared repo entirely, and git silently ignores an include whose
# path doesn't exist, so a machine with no extra identities is unaffected.
[include]
	path = ~/.gitconfig-local
